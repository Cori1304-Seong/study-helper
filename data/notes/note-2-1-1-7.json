  "sections": [
    {
      "id": "note-2-1-1-7/commands",
      "title": "명령어 표",
      "kind": "command",
      "items": [
        {
          "term": "users",
          "desc": "현재 로그인한 사용자 ID만 단어 형태로 나열\t출력  ex) root user1 user2"
        },
        {
          "term": "who",
          "desc": "현재 로그인한 모든 사용자 목록 + TTY + 접속 시간 출력",
          "options": [
            {
              "flag": "-b",
              "meaning": "시스템이 마지막으로 부팅된 시간을 출력한다."
            },
            {
              "flag": "-d",
              "meaning": "현재 죽은 프로세스 목록을 출력한다."
            },
            {
              "flag": "-H",
              "meaning": "출력 결과 맨 위에 헤더(HEADER)행을 추가한다"
            },
            {
              "flag": "-l",
              "meaning": "현재 로그인 대기 중인 프로세스를 출력한다"
            },
            {
              "flag": "-m",
              "meaning": "최초로 열고 들어온 진짜 세션의 주인 출력($who am i는 현재 로그인 계정을 출력)"
            }
          ],
          "detail": "# tty: 현재 사용자가 접속해 있는 '터미널(단말기) 장치'\n$ who\nroot     tty1         2026-10-07 09:00\nuser01   pts/0        2026-10-07 10:15 (192.168.1.50)\ndevuser  pts/1        2026-10-07 13:20 (192.168.1.88)"
        },
        {
          "term": "whoami",
          "desc": "현재 실질적으로 사용 중인 권한자를 출력"
        },
        {
          "term": "w",
          "desc": "현재 로그인한 모든 사용자 + 그들이 실행 중인 프로세스 출력",
          "options": [
            {
              "flag": "-h",
              "meaning": "윗부분 설명인 헤더를 출력하지 않는다."
            },
            {
              "flag": "-s",
              "meaning": "LOGIN@, JCPU, PCPU를 제외하고 간략히 출력"
            }
          ]
        },
        {
          "term": "logname",
          "desc": "su 명령으로 사용자 전환했을 경우에 최초의 로그인 계정을 출력한다. (오직 사용자 이름 단어 1개만 출력)"
        },
        {
          "term": "id ",
          "desc": "사용자의 UID, GID, 속한 그룹 목록 출력 (SELinux를 사용하는 경우 context라는 항목이 추가되어 출력됨) ",
          "options": [
            {
              "flag": "-g",
              "meaning": "주 그룹의 GID만 출력한다. "
            },
            {
              "flag": "-G",
              "meaning": "사용자가 속한 모든 그룹의 GID를 출력한다. "
            },
            {
              "flag": "-u",
              "meaning": "사용자의 UID 값만 출력한다."
            },
            {
              "flag": "-n",
              "meaning": "-u나 -g 옵션과 같이 사용되며, 숫자값인 UID 나 GID 대신에 이름으로 출력한다."
            }
          ]
        }
      ]
    }
  ],
  "updatedAt": "2026-10-07T05:59:16.336Z"
}
