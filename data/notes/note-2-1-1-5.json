    {
      "id": "note-2-1-1-5/commands",
      "title": "명령어 표",
      "kind": "command",
      "items": [
        {
          "term": "passwd",
          "desc": "패스워드 부여 또는 변경하는 명령어지만, 계정을 사용하지 못하게 하거나 패스워드 만기일 및 유효기간 등을 설정할 수 있다, ",
          "options": [
            {
              "flag": "-l",
              "meaning": "사용자의 패스워드에 잠금을 걸어 로그인을 막음"
            },
            {
              "flag": "-u",
              "meaning": "사용자의 패스워드 잠금 해제"
            },
            {
              "flag": "-d",
              "meaning": "사용자의 패스워드 제거(패스워드 없이 로그인 가능)"
            },
            {
              "flag": "-n",
              "meaning": "패스워드 변경까지의 최소 날짜 설정"
            },
            {
              "flag": "-x",
              "meaning": "현재 패스워드의 유효 기간 설정"
            },
            {
              "flag": "-e",
              "meaning": "다음에 로그인 시에 반드시 패스워드 변경 설정(/etc/shadow의 세 번째 필드의 값이 0으로 설정됨) "
            }
          ]
        },
        {
          "term": "chage",
          "desc": "사용자의 패스워드 정보를 출력하고 설정한다. /etc/shadow의 날짜 관련 필드 설정을 모두 할 수 있는 명령어",
          "options": [
            {
              "flag": "-m",
              "meaning": "패스워드 변경의 최소 날짜 지정",
              "detail": "$ chage -m 10 -M 100 -W 5 -I 3 posein\nposein의 패스워드 최소 사용날짜는 10일, 최대 사용 가능한 날은 100일로 설정한다. 또한 패스워드 만기일로부터 5일전 경고 메시지를 보내주고, 만기일 이후 3일이 지나도 변경하지 않으면 패스워드에 잠금을 설정해서 로그인을 막는다. \n"
            },
            {
              "flag": "-M",
              "meaning": "패스워드 변경 없이 사용 가능한 최대 날짜 지정"
            },
            {
              "flag": "-W ",
              "meaning": "패스워드 만료 전 변경을 요구하는 경고 날짜 지정 "
            },
            {
              "flag": "-I",
              "meaning": "패스워드 최대 사용기간 만료 후에 실제 패스워드에 잠금을 설정하기까지의 유예기간 설정"
            },
            {
              "flag": "-E",
              "meaning": "계정이 만기되는 날 지정 "
            },
            {
              "flag": "-d",
              "meaning": "/etc/shadow의 3번째 필드에 해당하는 값인 최근 패스워드를 바꾼 날을 수정"
            }
          ]
        }
      ]
    }
  ],
